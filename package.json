{
  "name": "outflow",
  "version": "1.2.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:pwa:server": "npm run build && node e2e/pwa-static-server.mjs",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "e2e:sync:uat": "playwright test -c playwright.uat.config.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "lint": "biome check src/ e2e/ playwright.config.ts playwright.pwa.config.ts playwright.uat.config.ts",
    "lint:fix": "biome check src/ e2e/ playwright.config.ts playwright.pwa.config.ts playwright.uat.config.ts --write",
    "format": "biome format src/ e2e/ playwright.config.ts playwright.pwa.config.ts playwright.uat.config.ts --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.9.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.9"
  }
}
